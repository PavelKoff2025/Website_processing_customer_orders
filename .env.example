# =============================================================================
#  Шаблон окружения. Рабочий .env генерируется скриптом scripts/bootstrap.sh
#  (со случайными паролями) и НЕ должен попадать в git.
# =============================================================================

# --- общее -------------------------------------------------------------------
TZ=Europe/Moscow

# Публичное имя/адрес сервера — используется в сертификате и адресе реестра.
PUBLIC_HOST=example.com
REGISTRY_HOST=example.com:5000
ACME_EMAIL=admin@example.com

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=autello
POSTGRES_USER=autello
POSTGRES_PASSWORD=change-me
# Адрес БД внутри контура (DNS-имя сервиса в сети autello_db).
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- pgAdmin (вход в саму панель; сверху ещё Basic-Auth на Nginx) ------------
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me

# Basic-Auth перед pgAdmin (генерируется в nginx/auth/pgadmin.htpasswd)
PGADMIN_BASIC_USER=ops
PGADMIN_BASIC_PASSWORD=change-me

# --- Docker Registry (креды для `docker login`) ------------------------------
# Реестр публикуется напрямую по plain HTTP на REGISTRY_PORT, поэтому пароль
# ходит по сети незашифрованным. Порт обязательно ограничить фаерволом.
REGISTRY_USER=admin
REGISTRY_PASSWORD=change-me
REGISTRY_HTTP_SECRET=change-me

# --- Watchtower --------------------------------------------------------------
# Интервал проверки обновлений, секунды (300 = каждые 5 минут).
WATCHTOWER_INTERVAL=300
# Тип обновления. --label-enable = только помеченные контейнеры (backend).
# Доступны также --monitor-only (только уведомлять) и --rolling-restart.
# Кавычки обязательны: значение содержит пробелы.
WATCHTOWER_ARGS="--cleanup --label-enable --rolling-restart"

# --- Публичные порты (то, куда обращаемся снаружи) --------------------------
HTTP_PORT=80
HTTPS_PORT=443
REGISTRY_PORT=5000

# IP, с которых можно ходить на порт реестра (scripts/firewall-registry.sh)
TRUSTED_REGISTRY_IPS="127.0.0.1"
